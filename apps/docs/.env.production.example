# apps/docs in production (docs.asafarim.site, the os-docs service). Values never go in git as plaintext.
#
# 1. `pnpm env:decrypt:production` writes apps/docs/.env.production (git-ignored) from the committed
#    apps/docs/.env.production.age; or copy this file there. Fill it in.
# 2. `pnpm env:encrypt:production` writes apps/docs/.env.production.age: commit only that.
# 3. On the VPS, deploy/vps-deploy.sh decrypts it into .env.docs (the os-docs env_file) and checks that every
#    uncommented NAME= line below is filled, by name, never by value.
#
# ASAFARIM_APP_ID and OIDC_ISSUER are set in deploy/compose.prod.yml, not here.

# Auth.js's session secret: at least 32 random bytes (`openssl rand -base64 33`). Rotating it signs everyone out.
AUTH_SECRET=

# Not required yet. Uncomment and fill each one as its part goes live (#83):
#
# The documents: a fine-grained GitHub token with Contents read on the source repository only.
# DOCS_GITHUB_TOKEN=
# Turning a note into an issue: a token that can create issues in the repositories that own the documents.
# DOCS_ISSUES_TOKEN=
# The Claude API key that drafts those issues.
# DOCS_AI_API_KEY=
# Study notes: the app's own Postgres database.
# DATABASE_URL=
# Registration and permission checks: core-api, once it runs in production.
# CORE_API_URL=
# ASAFARIM_REGISTRY_CREDENTIAL=
# OIDC client secret (confidential client, set in identity's clients.json)
OIDC_CLIENT_SECRET=
