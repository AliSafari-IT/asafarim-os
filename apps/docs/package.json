{
  "name": "@asafarim/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Docs: a private reader for documentation repositories on ASafariM OS (#76). This is the scaffold: sign-in, registration and an empty reading layout.",
  "scripts": {
    "dev": "next dev --port 4110",
    "build": "next build",
    "start": "next start --port 4110",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:no-content": "node scripts/check-no-content.mjs"
  },
  "dependencies": {
    "@asafarim/app-manifest": "workspace:*",
    "@asafarim/app-sdk": "workspace:*",
    "@asafarim/telemetry": "workspace:*",
    "@asafarim/theme": "workspace:*",
    "@asafarim/markdown-utils": "1.3.3",
    "@shikijs/rehype": "4.4.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "lighthouse": "13.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
