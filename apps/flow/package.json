{
  "name": "@asafarim/flow",
  "version": "0.1.0",
  "private": true,
  "description": "Flow: ASafariM OS workflows across apps, through events only (ADR 0001). Its first workflow turns a #issue study note in Docs into a GitHub issue.",
  "scripts": {
    "dev": "next dev --port 4130",
    "build": "next build",
    "start": "next start --port 4130",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "credentials:rotate-key": "node scripts/rotate-credentials-key.mjs"
  },
  "dependencies": {
    "@asafarim/app-manifest": "workspace:*",
    "@asafarim/app-sdk": "workspace:*",
    "@asafarim/progress-bars": "^0.7.3",
    "@asafarim/smtp": "workspace:*",
    "@asafarim/telemetry": "workspace:*",
    "@asafarim/theme": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
