{
  "id": "knowledge",
  "name": "ASafariM Knowledge",
  "version": "0.4.0",
  "platform": ">=0.1 <1",
  "owner": "ASafariM Digital",
  "domains": {
    "primary": "learn.asafarim.site"
  },
  "runtime": {
    "image": "knowledge",
    "port": 3000,
    "health": {
      "live": "/health/live",
      "ready": "/health/ready"
    },
    "resources": {
      "memory": "256m",
      "cpus": 0.5
    }
  },
  "database": {
    "engine": "postgres",
    "migrations": "sql"
  },
  "auth": {
    "client": "oidc",
    "publicPaths": [
      "/",
      "/articles/**",
      "/courses",
      "/courses/**",
      "/search",
      "/topics/**",
      "/api/public/**",
      "/feed.xml",
      "/api/engagement/**",
      "/media/**",
      "/health/live",
      "/health/ready"
    ]
  },
  "permissions": [
    {
      "key": "knowledge.content.create",
      "description": "Open the studio and create article drafts"
    },
    {
      "key": "knowledge.content.edit.own",
      "description": "Edit and save drafts of your own articles"
    },
    {
      "key": "knowledge.content.edit.any",
      "description": "Edit and save drafts of any article"
    },
    {
      "key": "knowledge.content.publish.own",
      "description": "Publish and withdraw your own articles"
    },
    {
      "key": "knowledge.content.publish.any",
      "description": "Publish and withdraw any article"
    },
    {
      "key": "knowledge.taxonomy.manage",
      "description": "Create topics and the curated tags (with aliases) authors classify articles with"
    },
    {
      "key": "knowledge.courses.manage.own",
      "description": "Create courses from published articles, and edit, publish and withdraw your own courses"
    },
    {
      "key": "knowledge.courses.manage.any",
      "description": "Edit, publish and withdraw any course"
    },
    {
      "key": "knowledge.comment.write",
      "description": "Write comments and replies on lessons, and edit or delete your own"
    },
    {
      "key": "knowledge.comment.moderate",
      "description": "Delete anyone's comments on lessons"
    },
    {
      "key": "knowledge.ai.use",
      "description": "Ask the AI for proposals (outline, rewrite, summary, diagram) on articles you may edit"
    }
  ],
  "roles": [
    {
      "key": "knowledge.author",
      "grants": [
        "knowledge.content.create",
        "knowledge.content.edit.own",
        "knowledge.content.publish.own",
        "knowledge.courses.manage.own",
        "knowledge.ai.use",
        "knowledge.comment.write"
      ],
      "description": "Writes, publishes and withdraws their own articles and courses"
    },
    {
      "key": "knowledge.editor",
      "grants": [
        "knowledge.content.create",
        "knowledge.content.edit.own",
        "knowledge.content.edit.any",
        "knowledge.content.publish.own",
        "knowledge.content.publish.any",
        "knowledge.taxonomy.manage",
        "knowledge.courses.manage.own",
        "knowledge.courses.manage.any",
        "knowledge.ai.use",
        "knowledge.comment.write",
        "knowledge.comment.moderate"
      ],
      "description": "Edits, publishes and withdraws any article or course, curates topics and tags, and moderates comments"
    },
    {
      "key": "knowledge.learner",
      "grants": [
        "knowledge.comment.write"
      ],
      "description": "Comments on lessons (anyone may read them and like a lesson)"
    }
  ],
  "routes": [
    {
      "path": "/studio/**",
      "methods": [
        "GET",
        "HEAD"
      ],
      "permission": "knowledge.content.create"
    }
  ],
  "events": {
    "publishes": [
      {
        "type": "knowledge.comment.created.v2",
        "schema": "./events/knowledge.comment.created.v2.json"
      }
    ]
  },
  "secrets": [
    "KNOWLEDGE_AI_API_KEY",
    "KNOWLEDGE_MEDIA_ACCESS_KEY",
    "KNOWLEDGE_MEDIA_SECRET_KEY",
    "ENGAGEMENT_SALT"
  ],
  "ui": {
    "glyph": "KN",
    "color": "#0e7490",
    "nav": [
      {
        "label": "Articles",
        "href": "/"
      },
      {
        "label": "Courses",
        "href": "/courses"
      },
      {
        "label": "Studio",
        "href": "/studio"
      }
    ],
    "status": "active",
    "launcher": {
      "description": "Technical articles and learning from ASafariM: read what has been published, write in the studio.",
      "meta": "learn.asafarim.site",
      "access": "public",
      "requiresAccountToUse": true,
      "order": 40
    }
  }
}
