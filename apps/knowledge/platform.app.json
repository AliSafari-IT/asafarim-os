{
  "id": "knowledge",
  "name": "ASafariM Knowledge",
  "version": "0.1.5",
  "platform": ">=0.1 <1",
  "owner": "ASafariM Digital",
  "domains": {
    "primary": "learn.asafarim.site"
  },
  "runtime": {
    "image": "knowledge",
    "port": 3000,
    "health": {
      "live": "/health/live",
      "ready": "/health/ready"
    },
    "resources": {
      "memory": "256m",
      "cpus": 0.5
    }
  },
  "database": {
    "engine": "postgres",
    "migrations": "sql"
  },
  "auth": {
    "client": "oidc",
    "publicPaths": ["/", "/articles/**", "/health/live", "/health/ready"]
  },
  "permissions": [
    {
      "key": "knowledge.content.create",
      "description": "Open the studio and create article drafts"
    },
    {
      "key": "knowledge.content.edit.own",
      "description": "Edit and save drafts of your own articles"
    },
    {
      "key": "knowledge.content.edit.any",
      "description": "Edit and save drafts of any article"
    },
    {
      "key": "knowledge.content.publish.own",
      "description": "Publish and withdraw your own articles"
    },
    {
      "key": "knowledge.content.publish.any",
      "description": "Publish and withdraw any article"
    }
  ],
  "roles": [
    {
      "key": "knowledge.author",
      "grants": ["knowledge.content.create", "knowledge.content.edit.own", "knowledge.content.publish.own"],
      "description": "Writes, publishes and withdraws their own articles"
    },
    {
      "key": "knowledge.editor",
      "grants": [
        "knowledge.content.create",
        "knowledge.content.edit.own",
        "knowledge.content.edit.any",
        "knowledge.content.publish.own",
        "knowledge.content.publish.any"
      ],
      "description": "Edits, publishes and withdraws any article"
    }
  ],
  "routes": [
    {
      "path": "/studio/**",
      "methods": ["GET", "HEAD"],
      "permission": "knowledge.content.create"
    }
  ],
  "ui": {
    "glyph": "KN",
    "color": "#0e7490",
    "nav": [
      {
        "label": "Articles",
        "href": "/"
      },
      {
        "label": "Studio",
        "href": "/studio"
      }
    ],
    "status": "active",
    "launcher": {
      "description": "Technical articles and learning from ASafariM: read what has been published, write in the studio.",
      "meta": "learn.asafarim.site",
      "access": "public",
      "requiresAccountToUse": true,
      "order": 40
    }
  }
}
