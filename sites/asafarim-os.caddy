# asafarim-os stack's site file on the shared edge (asafarim-platform #770; asafarim-os#45).
# Published by deploy/vps-deploy.sh through the edge's edge-deploy-site.sh, which validates the
# WHOLE edge config before swapping this file in. Nobody edits another stack's file.
#
# Snippet names share one namespace across every stack's file: keep the asafarim_os_ prefix
# (there are no snippets here yet).
#
# id.asafarim.site (identity), since #70 the asafarim.site landing page (os-site), and since #83
# docs.asafarim.site (os-docs), and since #175 admin.asafarim.site (os-admin). Cutover: the asafarim.site and www.asafarim.site blocks must first be
# removed from asafarim-com.caddy; the edge validates the WHOLE config, so publishing this file while both
# define asafarim.site fails safely.

# The OpenID Connect provider. Reached on the shared edge_net under the unique alias
# os-identity (never the bare service name: upstream names on edge_net are shared).
id.asafarim.site {
  header {
    # HTTPS only (Caddy sends no HSTS by default). Same value as the asafarim.site block below.
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    # An authentication host: never leak its URLs (interaction ids) in a Referer. This is
    # the value identity sets itself on the hand-off page, so the two never disagree.
    Referrer-Policy no-referrer
  }
  # No Content-Security-Policy here on purpose: identity sets a strict one per page (the
  # hand-off page's CSP forbids scripts and forms), and a second one from the edge would
  # intersect with it and could break that page.
  reverse_proxy os-identity:3000
}

# The OS landing page (#70): static files from os-site:8080 (core/site). Its one script and stylesheet
# are this origin's own, and the script only asks identity who is signed in (session.js -> /whoami), so
# the CSP allows this origin's script, stylesheet and images, and connections to identity alone. The
# container sends the same headers itself (core/site/nginx.conf; deploy/compose.prod.test.mjs checks
# that the two CSPs match); `defer` makes the edge's values replace the upstream's instead of
# sending each header twice.
asafarim.site {
  header {
    defer
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://id.asafarim.site; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    -Server
  }
  reverse_proxy os-site:8080
}

www.asafarim.site {
  redir https://asafarim.site{uri} 301
}

# The Docs app (#83): a Next.js server at os-docs:3000 (apps/docs). Private: every page but /api/health asks
# for a sign-in, and the app sends X-Robots-Tag itself. No Content-Security-Policy here on purpose: Next's
# pages need their inline scripts, and the app sets a sandboxing CSP of its own on the SVG images it serves
# (/api/files), which an edge CSP under `defer` would replace. `defer` makes the edge's values replace the
# upstream's instead of sending each header twice.
docs.asafarim.site {
  header {
    defer
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    # Document paths are private: never leak them in a Referer.
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    X-Robots-Tag "noindex, nofollow"
    -Server
    -X-Powered-By
  }
  reverse_proxy os-docs:3000
}

# The Admin console (asafarim-os#175): a Next.js server at os-admin:3000 (core/admin). Private: every page but
# /api/health asks for a sign-in, and core-api checks `core.admin` on every call. No Content-Security-Policy here
# for the same reason as docs: Next's pages need their inline scripts, and `defer` makes the edge's values replace
# the upstream's instead of sending each header twice.
admin.asafarim.site {
  header {
    defer
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    X-Robots-Tag "noindex, nofollow"
    -Server
    -X-Powered-By
  }
  reverse_proxy os-admin:3000
}
