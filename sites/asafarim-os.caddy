# asafarim-os stack's site file on the shared edge (asafarim-platform #770; asafarim-os#45).
# Published by deploy/vps-deploy.sh through the edge's edge-deploy-site.sh, which validates the
# WHOLE edge config before swapping this file in. Nobody edits another stack's file.
#
# Snippet names share one namespace across every stack's file: keep the asafarim_os_ prefix
# (there are no snippets here yet).
#
# id.asafarim.site (identity) and, since #70, the asafarim.site landing page (os-site). Cutover: the
# asafarim.site and www.asafarim.site blocks must first be removed from asafarim-com.caddy; the edge
# validates the WHOLE config, so publishing this file while both define asafarim.site fails safely.

# The OpenID Connect provider. Reached on the shared edge_net under the unique alias
# os-identity (never the bare service name: upstream names on edge_net are shared).
id.asafarim.site {
  header {
    # HTTPS only (Caddy sends no HSTS by default). Same value as the asafarim.site block below.
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    # An authentication host: never leak its URLs (interaction ids) in a Referer. This is
    # the value identity sets itself on the hand-off page, so the two never disagree.
    Referrer-Policy no-referrer
  }
  # No Content-Security-Policy here on purpose: identity sets a strict one per page (the
  # hand-off page's CSP forbids scripts and forms), and a second one from the edge would
  # intersect with it and could break that page.
  reverse_proxy os-identity:3000
}

# The OS landing page (#70): static files from os-site:8080 (core/site). The page has no scripts and
# loads nothing from another origin, so the CSP allows only this origin's stylesheet and images. The
# container sends the same headers itself (core/site/nginx.conf; deploy/compose.prod.test.mjs checks
# that the two CSPs match); `defer` makes the edge's values replace the upstream's instead of
# sending each header twice.
asafarim.site {
  header {
    defer
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    -Server
  }
  reverse_proxy os-site:8080
}

www.asafarim.site {
  redir https://asafarim.site{uri} 301
}
