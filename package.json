{
  "name": "asafarim-os",
  "version": "0.1.0",
  "private": true,
  "description": "ASafariM OS — a small core platform and self-describing app plugins",
  "author": "Ali Safari",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "platform": "turbo run build --filter=@asafarim/platform-cli^... --output-logs=errors-only && pnpm --filter @asafarim/platform-cli exec tsx src/cli.ts",
    "platform:sync": "pnpm platform sync",
    "platform:sync:check": "pnpm platform sync --check",
    "platform:boundaries": "pnpm platform boundaries",
    "check:brand": "node scripts/check-brand-spelling.mjs && node --test scripts/check-brand-spelling.test.mjs",
    "test:scripts": "node --test scripts/dev/keys.test.mjs scripts/dev/dev-app.test.mjs scripts/dev/infra.test.mjs scripts/dev/compose.dev.test.mjs scripts/check-env-safety.test.mjs scripts/session-ttl.test.mjs deploy/compose.prod.test.mjs deploy/vps-deploy.test.mjs deploy/redeploy.test.mjs deploy/ci-deploy.test.mjs",
    "dev": "node scripts/dev/dev.mjs",
    "dev:app": "node scripts/dev/dev-app.mjs",
    "dev:keys": "node scripts/dev/keys.mjs",
    "dev:reset": "node scripts/dev/reset.mjs",
    "dev:smoke": "node scripts/dev/smoke.mjs",
    "dev:telemetry": "node scripts/dev/telemetry.mjs",
    "redeploy": "bash deploy/redeploy.sh",
    "e2e": "node scripts/dev/e2e.mjs",
    "screenshots": "node scripts/dev/e2e.mjs --screenshots",
    "env:status": "envage status",
    "env:check": "node scripts/check-env-safety.mjs",
    "env:key:init": "envage init-key",
    "env:encrypt": "envage encrypt --all --env root",
    "env:decrypt": "envage decrypt --all --env root",
    "env:encrypt:production": "envage encrypt --all --env production",
    "env:decrypt:production": "envage decrypt --all --env production"
  },
  "devDependencies": {
    "@asafarim/envage": "^0.4.2",
    "@nats-io/nkeys": "^2.0.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  },
  "dependencies": {}
}
