# Generated by `platform sync` from apps/*/platform.app.json (routes). Do not edit: change the manifest and run sync.
# The DEV gateway (P3.3a): local and CI only. Production sites are generated separately (ADR 0001 §7).
#
# Per app, <id>.localhost: expose:false paths answer 404 here; every other request is checked by core-api
# (forward_auth → /authz/check: 503 not active, 404 hidden, 401, 403 naming the permission, or 200) and
# only then proxied to the app. Upstreams come from the environment (the dev scripts write .dev/gateway.env).
{
	admin off
	auto_https off
}

http://id.localhost:8080 {
	reverse_proxy {$OS_IDENTITY_UPSTREAM}
}

http://api.localhost:8080 {
	reverse_proxy {$OS_CORE_API_UPSTREAM}
}

http://notes.localhost:8080 {
	@hidden1 {
		path /internal /internal/*
	}
	handle @hidden1 {
		respond "Not found" 404
	}
	handle {
		forward_auth {$OS_CORE_API_UPSTREAM} {
			uri /authz/check
			header_up X-Asafarim-App notes
		}
		reverse_proxy {$OS_APP_NOTES_UPSTREAM}
	}
}

# Any other host: a 404, and a health answer for the container's own check.
http://:8080 {
	handle /gateway-health {
		respond "ok" 200
	}
	handle {
		respond "Not found" 404
	}
}
