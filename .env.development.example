# ASafariM OS local development (OS-D1, #26). You don't copy this file:
# `pnpm dev:keys` (run by `pnpm dev`) writes the real values, all throwaway and
# dev-only, into the git-ignored .dev/ folder. This file only documents them.

# .dev/identity.env (core/identity, loaded with node --env-file)
NODE_ENV=development
PORT=4010
IDENTITY_ISSUER=http://localhost:4010
IDENTITY_HUB_CONTINUE_URL=http://localhost:4000/oidc/continue
IDENTITY_REDIS_URL=redis://127.0.0.1:56380/3
IDENTITY_ACCOUNTS_DATABASE_URL=postgres://identity_ro:<generated>@127.0.0.1:55440/os_accounts
IDENTITY_OIDC_JWKS=<generated EC P-256 private JWK set>
IDENTITY_COOKIE_KEYS=<generated>
IDENTITY_HANDOFF_PRIVATE_JWK=<generated Ed25519 private JWK>
IDENTITY_HUB_PUBLIC_JWK=<the dev hub's generated Ed25519 public JWK>
IDENTITY_CLIENTS_FILE=<absolute path to .dev/clients.json>
IDENTITY_TRUST_PROXY=false

# .dev/dev-hub.env (tools/dev-hub, the DEV ONLY login stub)
DEV_HUB_PORT=4000
DEV_HUB_IDENTITY_ISSUER=http://localhost:4010
DEV_HUB_TICKET_PUBLIC_JWK=<identity's generated Ed25519 public JWK>
DEV_HUB_ASSERTION_PRIVATE_JWK=<generated Ed25519 private JWK>

# .dev/db.env (the bootstrap)
POSTGRES_ADMIN_URL=postgres://postgres:postgres-dev-only@127.0.0.1:55440/postgres
OS_ACCOUNTS_PASSWORD=<generated>
IDENTITY_RO_PASSWORD=<generated>

# .dev/core-api.env (core/core-api)
NODE_ENV=development
PORT=4020
CORE_API_URL=http://localhost:4020
CORE_API_DATABASE_URL=postgres://core_api:<generated>@127.0.0.1:55440/core
CORE_API_PROVISIONER_URL=postgres://postgres:postgres-dev-only@127.0.0.1:55440/postgres
CORE_API_ADMIN_TOKEN=<generated, >= 32 characters: the CLI's bearer token (bootstrap and CI)>
CORE_API_TOKEN_SIGNING_JWK=<generated Ed25519 private JWK with a kid: signs the access tokens>
CORE_API_IDENTITY_ISSUER=http://localhost:4010
CORE_API_ADMIN_CLIENT_ID=core-admin
CORE_API_APP_URL_TEMPLATE=http://{id}.localhost:8080
# Optional: CORE_API_ACCESS_TOKEN_TTL_SECONDS (5 to 300, default 60), CORE_API_ADMIN_TOKEN_DISABLED=true

# .dev/app.env (every app under apps/*)
CORE_API_URL=http://localhost:4020
OIDC_ISSUER=http://localhost:4010
AUTH_SECRET=<generated>
AUTH_TRUST_HOST=true
ASAFARIM_ACCESS_TTL_MS=1000

# .dev/<app>.env (written by `platform app install <app> --env-out`; the credential is shown once)
ASAFARIM_APP_ID=notes
ASAFARIM_REGISTRY_CREDENTIAL=<osk1.…>
DATABASE_URL=<the app's own database>

# .dev/gateway.env (the dev gateway, compose.dev.yml; written on every run)
OS_IDENTITY_UPSTREAM=host.docker.internal:4010
OS_CORE_API_UPSTREAM=host.docker.internal:4020
OS_ADMIN_UPSTREAM=host.docker.internal:4030
OS_APP_NOTES_UPSTREAM=host.docker.internal:4100

# .dev/admin.env (core/admin, the Admin console; written on every run)
ADMIN_OIDC_CLIENT_ID=core-admin
ADMIN_USER_DIRECTORY_FILE=<absolute path to tools/dev-hub/seed-users.json>
