{
  "id": "testora",
  "name": "Testora",
  "version": "1.8.0",
  "platform": ">=0.1 <1",
  "owner": "ASafarIM Digital",
  "domains": { "primary": "testora.cloud", "aliases": ["www.testora.cloud", "testora.asafarim.com"] },
  "runtime": {
    "image": "testora",
    "port": 3000,
    "health": { "live": "/healthz", "ready": "/readyz" },
    "resources": { "memory": "768m", "cpus": 0.5 },
    "workers": [
      {
        "name": "runner",
        "image": "testora-runner",
        "network": "egress-only",
        "resources": { "memory": "3g", "cpus": 2 }
      }
    ]
  },
  "database": { "engine": "postgres", "migrations": "drizzle" },
  "auth": { "client": "oidc", "publicPaths": ["/", "/about-this-project", "/roadmap"] },
  "permissions": [
    { "key": "testora.results.read", "description": "See test results and evidence" },
    { "key": "testora.tests.run", "description": "Run tests against a target" },
    { "key": "testora.issues.report", "description": "Report a failure as a GitHub issue" },
    { "key": "testora.catalog.manage", "description": "Manage apps, suites, fixtures, targets" }
  ],
  "roles": [
    { "key": "testora.member", "grants": ["testora.results.read"] },
    { "key": "testora.tester", "grants": ["testora.results.read", "testora.tests.run", "testora.issues.report"] },
    { "key": "testora.admin", "grants": ["testora.*"] }
  ],
  "routes": [
    { "path": "/api/run", "methods": ["POST"], "permission": "testora.tests.run" },
    { "path": "/api/issues/**", "methods": ["POST"], "permission": "testora.issues.report" },
    { "path": "/internal/**", "expose": false }
  ],
  "events": {
    "publishes": [{ "type": "testora.run.completed.v1", "schema": "./events/run-completed.v1.json" }],
    "subscribes": [{ "type": "tasksai.feature.decomposed.v1", "handler": "/events/tasksai-decomposed" }]
  },
  "config": [{ "key": "runs.perTargetPerHour", "type": "int", "default": 30 }],
  "secrets": ["GITHUB_TOKEN", "TESTORA_SECRET"],
  "ui": {
    "glyph": "TO",
    "color": "#7c3aed",
    "nav": [{ "label": "Runs", "href": "/run" }],
    "status": "active"
  }
}
