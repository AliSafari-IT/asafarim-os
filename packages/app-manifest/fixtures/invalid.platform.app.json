{
  "id": "testora",
  "name": "Testora",
  "version": "1.8",
  "platform": ">=0.1 <1",
  "owner": "ASafariM Digital",
  "runtime": {
    "image": "testora",
    "port": 3000,
    "health": { "live": "/healthz", "ready": "/readyz" }
  },
  "database": { "engine": "postgres", "migrations": "drizzle" },
  "auth": { "client": "oidc", "publicPaths": ["/"] },
  "permissions": [
    { "key": "testora.tests.run", "description": "Run tests against a target" },
    { "key": "tasksai.tasks.write", "description": "Write TasksAI tasks" }
  ],
  "roles": [{ "key": "testora.tester", "grants": ["testora.tests.run", "hub.users.manage"] }],
  "routes": [{ "path": "/api/issues/**", "methods": ["POST"], "permission": "testora.issues.report" }],
  "events": { "publishes": [{ "type": "tasksai.task.created.v1", "schema": "./events/x.json" }] },
  "secrets": ["GITHUB_TOKEN", "postgres://app:example@db:5432/testora"],
  "ui": { "glyph": "TO", "color": "#7c3aed", "nav": [], "status": "active" }
}
