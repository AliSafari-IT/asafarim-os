{
  "name": "@asafarim/telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "ASafariM OS observability (P6.2): OpenTelemetry traces and per-route request metrics for an app, exported over OTLP, and a JSON logger that stamps each line with the active trace id. Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
