{
  "name": "@asafarim/locale",
  "version": "0.2.0",
  "private": true,
  "description": "The languages of ASafariM OS (en, nl, fr, de; English by default) and the country & language selector, shared by every site and app: one choice across *.asafarim.site, kept in a cookie. Server helpers, plus @asafarim/country-language-selector bundled once into a plain browser script and stylesheet, so upgrading it here upgrades every page.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./selector.js": "./selector.js",
    "./selector.css": "./selector.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "selector.js",
    "selector.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:selector": "node scripts/build-selector.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "next": "^16.4.3"
  },
  "dependencies": {
    "@asafarim/country-language-selector": "0.5.3"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {}
  }
}
