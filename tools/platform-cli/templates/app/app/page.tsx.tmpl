import { Launcher } from "@asafarim/app-sdk/react";
import { signInAction, signOutAction } from "./actions";
import { auth } from "@/lib/auth";
import { getPlatform } from "@/lib/platform";

export const dynamic = "force-dynamic";

export default async function Home() {
  const session = await auth();
  const subject = session?.user?.id;

  if (!subject) {
    return (
      <main>
        <header>
          <h1>{{name}}</h1>
        </header>
        <div className="card">
          <p>Sign in with your ASafariM account.</p>
          <form action={signInAction}>
            <button type="submit">Sign in</button>
          </form>
        </div>
      </main>
    );
  }

  // The apps this person can open (active, and they hold a role or it is public), decided by core-api.
  // A launcher that can't be loaded is left out: it must never break the page.
  const apps = await getPlatform()
    .access.launcher(subject)
    .catch(() => []);

  return (
    <main>
      <header>
        <div>
          <h1>{{name}}</h1>
          <span className="muted" data-testid="who">
            Signed in as {session?.user?.name ?? subject}
          </span>
        </div>
        <form action={signOutAction}>
          <button type="submit" className="secondary">
            Sign out
          </button>
        </form>
      </header>

      <Launcher apps={apps} current="{{id}}" label="Your apps" />
    </main>
  );
}
