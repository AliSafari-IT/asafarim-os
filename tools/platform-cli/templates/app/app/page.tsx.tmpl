import { AppSwitcher, UserMenu } from "@asafarim/app-sdk/react";
import { signInAction, signOutAction } from "./actions";
import { auth } from "@/lib/auth";
import { describeAccess } from "@/lib/gate";
import { getPlatform } from "@/lib/platform";

export const dynamic = "force-dynamic";

export default async function Home() {
  const session = await auth();
  const subject = session?.user?.id;

  if (!subject) {
    return (
      <main>
        <header>
          <h1>{{name}}</h1>
        </header>
        <div className="card">
          <p>Sign in with your ASafariM account.</p>
          <form action={signInAction}>
            <button type="submit">Sign in</button>
          </form>
        </div>
      </main>
    );
  }

  // The apps this person can open (active, and they hold a role or it is public), decided by core-api.
  // A launcher that can't be loaded is left out: it must never break the page.
  const [apps, access] = await Promise.all([
    getPlatform()
      .access.launcher(subject)
      .catch(() => []),
    describeAccess(subject),
  ]);
  // What the app shows is decided by the permission core-api grants, never by the sign-in alone.
  const canRead = access.state === "active" && access.permissions.includes("{{id}}.read");

  return (
    <main>
      <header className="topbar">
        <div className="brand">
          <h1 className="visually-hidden">{{name}}</h1>
          {/* The OS's app switcher: this app and every other app this person can open (core-api's launcher). */}
          <AppSwitcher apps={apps} current="{{id}}" fallback={{ name: "{{name}}", glyph: "{{glyph}}" }} />
        </div>
        <span data-testid="who">
          {/* Who is signed in: name and email from the ID token, "Your account", the OS home and Sign out. */}
          <UserMenu
            name={session?.user?.name}
            email={session?.user?.email}
            signOut={
              <form action={signOutAction}>
                <button type="submit" data-testid="sign-out">
                  Sign out
                </button>
              </form>
            }
          />
        </span>
      </header>

      {!access.available ? (
        <div className="card" data-testid="state">
          Permissions can&apos;t be checked right now (core-api is unreachable).
        </div>
      ) : access.state !== "active" ? (
        <div className="card" data-testid="state">
          This app is <strong>{access.state}</strong>. An admin has to activate it.
        </div>
      ) : canRead ? (
        <div className="card" data-testid="content">
          <p>Welcome to {{name}}.</p>
        </div>
      ) : (
        <div className="card" data-testid="no-read">
          Opening {{name}} needs the permission <code>{{id}}.read</code>. Ask an admin for the <code>{{id}}.user</code>{" "}
          role.
        </div>
      )}
    </main>
  );
}
