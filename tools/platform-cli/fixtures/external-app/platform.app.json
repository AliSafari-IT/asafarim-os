{
  "id": "ext-demo",
  "name": "External demo",
  "version": "0.1.0",
  "platform": ">=0.1 <1",
  "owner": "ASafariM Digital",
  "runtime": {
    "image": "ext-demo",
    "port": 4120,
    "health": {
      "live": "/health/live",
      "ready": "/health/ready"
    },
    "resources": {
      "memory": "32m",
      "cpus": 0.25
    },
