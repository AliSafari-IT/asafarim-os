      {
        "name": "jobs",
        "image": "ext-demo",
        "network": "internal",
        "resources": {
          "memory": "32m",
          "cpus": 0.25
        }
      }
    ]
  },
  "database": {
    "engine": "postgres",
    "migrations": "sql",
    "dedicated": true
  },
  "auth": {
    "client": "none",
    "publicPaths": ["/"]
  },
  "permissions": [],
  "roles": [],
  "secrets": ["EXT_DEMO_API_KEY"],
  "ui": {
    "glyph": "EX",
    "color": "#64748b",
    "nav": [],
    "status": "coming-soon"
  }
