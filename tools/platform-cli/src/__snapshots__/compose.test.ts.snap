// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the generated file > matches the snapshot for an IGS-shaped app (web, worker, database, two secrets) 1`] = `
"# Generated by \`platform app compose igs-pharma --env staging\`: the staging stack of the external app igs-pharma. Edit the manifest or the options, not this file.
# It holds no secret value: each \${NAME} below is answered by the environment (or an env file) when compose runs.
# \`up\` needs IGS_PHARMA_DATABASE_URL, IGS_SESSION_SECRET, IGS_MAIL_API_KEY, and the external network igs_pharma_staging_db (the database's).
# IGS_PHARMA_MIGRATOR_DATABASE_URL is only for the migration, not for \`up\`: supply it inline for that one command, and keep it out of the runtime env file:
#   IGS_PHARMA_MIGRATOR_DATABASE_URL=… docker compose -p os-app-igs-pharma-staging -f <this file> --profile migrate run --rm migrate
# Then: docker compose -p os-app-igs-pharma-staging -f <this file> up -d
# The gateway reaches the app at OS_APP_IGS_PHARMA_UPSTREAM=os-app-igs-pharma-staging:3000.
name: os-app-igs-pharma-staging
services:
  web:
    image: ghcr.io/alisafari-it/igs-pharma-web:0123456789abcdef0123456789abcdef01234567
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 512m
    cpus: 1
    expose:
      - "3000"
    environment:
      DATABASE_URL: \${IGS_PHARMA_DATABASE_URL:?set IGS_PHARMA_DATABASE_URL}
      IGS_SESSION_SECRET: \${IGS_SESSION_SECRET:?set IGS_SESSION_SECRET}
      IGS_MAIL_API_KEY: \${IGS_MAIL_API_KEY:?set IGS_MAIL_API_KEY}
    networks:
      app_net: {}
      db_net: {}
      edge_net:
        aliases:
          - os-app-igs-pharma-staging
  worker:
    image: ghcr.io/alisafari-it/igs-pharma-worker:0123456789abcdef0123456789abcdef01234567
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 256m
    cpus: 0.5
    environment:
      DATABASE_URL: \${IGS_PHARMA_DATABASE_URL:?set IGS_PHARMA_DATABASE_URL}
      IGS_SESSION_SECRET: \${IGS_SESSION_SECRET:?set IGS_SESSION_SECRET}
      IGS_MAIL_API_KEY: \${IGS_MAIL_API_KEY:?set IGS_MAIL_API_KEY}
    networks:
      app_net: {}
      db_net: {}
      egress_net: {}
  migrate:
    image: ghcr.io/alisafari-it/igs-pharma-web:0123456789abcdef0123456789abcdef01234567
    profiles:
      - migrate
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 512m
    cpus: 1
    entrypoint:
      - drizzle-kit
      - migrate
    environment:
      DATABASE_URL: \${IGS_PHARMA_MIGRATOR_DATABASE_URL:-}
    networks:
      db_net: {}
networks:
  app_net:
    internal: true
  edge_net:
    external: true
    name: edge_net
  db_net:
    external: true
    name: igs_pharma_staging_db
  egress_net: {}
"
`;

exports[`the generated file > matches the snapshot for the ext-demo fixture (digests, sql migrations) 1`] = `
"# Generated by \`platform app compose ext-demo --env prod\`: the prod stack of the external app ext-demo. Edit the manifest or the options, not this file.
# It holds no secret value: each \${NAME} below is answered by the environment (or an env file) when compose runs.
# \`up\` needs EXT_DEMO_DATABASE_URL, EXT_DEMO_API_KEY, and the external network ext_demo_db (the database's).
# EXT_DEMO_MIGRATOR_DATABASE_URL is only for the migration, not for \`up\`: supply it inline for that one command, and keep it out of the runtime env file:
#   EXT_DEMO_MIGRATOR_DATABASE_URL=… docker compose -p os-app-ext-demo -f <this file> --profile migrate run --rm migrate
# Then: docker compose -p os-app-ext-demo -f <this file> up -d
# The gateway reaches the app at OS_APP_EXT_DEMO_UPSTREAM=os-app-ext-demo:4120.
name: os-app-ext-demo
services:
  web:
    image: ghcr.io/example/ext-demo@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 32m
    cpus: 0.25
    expose:
      - "4120"
    environment:
      DATABASE_URL: \${EXT_DEMO_DATABASE_URL:?set EXT_DEMO_DATABASE_URL}
      EXT_DEMO_API_KEY: \${EXT_DEMO_API_KEY:?set EXT_DEMO_API_KEY}
    networks:
      app_net: {}
      db_net: {}
      edge_net:
        aliases:
          - os-app-ext-demo
  jobs:
    image: ghcr.io/example/ext-demo-jobs@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 32m
    cpus: 0.25
    environment:
      DATABASE_URL: \${EXT_DEMO_DATABASE_URL:?set EXT_DEMO_DATABASE_URL}
      EXT_DEMO_API_KEY: \${EXT_DEMO_API_KEY:?set EXT_DEMO_API_KEY}
    networks:
      app_net: {}
      db_net: {}
  migrate:
    image: ghcr.io/example/ext-demo@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    profiles:
      - migrate
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 32m
    cpus: 0.25
    entrypoint:
      - /app/migrate
    environment:
      DATABASE_URL: \${EXT_DEMO_MIGRATOR_DATABASE_URL:-}
    networks:
      db_net: {}
networks:
  app_net:
    internal: true
  edge_net:
    external: true
    name: edge_net
  db_net:
    external: true
    name: ext_demo_db
"
`;
