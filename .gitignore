# Object file
*.o

# Ada Library Information
*.ali

# Dependencies and build output
node_modules/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Local dev keys, secrets and generated config (pnpm dev:keys)
.dev/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Playwright output
test-results/
playwright-report/

# --- envage managed ---
# Environment: secrets never go in git as plaintext; manifests list secret names only.
# Decrypted env files — never commit
.env*
!.env*.age
!.env.example
!.env.*.example
!.env.template
# Age keys: commit only the public recipient, never the private identity
.age/*
!.age/key.pub
# --- end envage ---
