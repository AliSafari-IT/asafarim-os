# core/identity in production (id.asafarim.site). Values never go in git as plaintext.
#
# 1. Copy this file to core/identity/.env.production (git-ignored) and fill it in.
#    `pnpm --filter @asafarim/identity keys` prints the key lines.
# 2. `pnpm env:encrypt:production` writes core/identity/.env.production.age: commit only that.
# 3. On the VPS: age -d -i .age/key.txt core/identity/.env.production.age > .env.identity
#    (the env_file in compose.snippet.yml). See README.md, "Production secrets".
#
# IDENTITY_ISSUER, IDENTITY_HUB_CONTINUE_URL, IDENTITY_CLIENTS_FILE and IDENTITY_REDIS_URL
# are set in compose.snippet.yml, not here.

# The platform DB as the identity_ro login role. asafarim-os owns this password;
# asafarim-platform's .env.production.age holds a copy (update both when it rotates).
IDENTITY_ACCOUNTS_DATABASE_URL=

# {"keys":[…]}: 1 private EC P-256 JWK with a kid (2 during a rotation; the first signs).
IDENTITY_OIDC_JWKS=

# Comma-separated, each >= 32 characters; the first signs.
IDENTITY_COOKIE_KEYS=

# Ed25519 private JWK: signs hand-off tickets. Its public half goes to Hub as
# HUB_IDENTITY_TICKET_PUBLIC_JWK.
IDENTITY_HANDOFF_PRIVATE_JWK=

# Hub's Ed25519 PUBLIC JWK: verifies Hub's assertions (a private key is refused).
IDENTITY_HUB_PUBLIC_JWK=

# One per confidential client, named by that client's client_secret_env (>= 32 characters).
# IDENTITY_CLIENT_SECRET_<APP>=

# --- Login method -------------------------------------------------------------------------
# hub (default): the Hub variables above. local: the service's own sign-in (below); the Hub ones
# and IDENTITY_ACCOUNTS_DATABASE_URL are then not needed. See README.md, "Local sign-in".
# IDENTITY_LOGIN_METHOD=local
# IDENTITY_SIGN_IN_METHODS=email,passkey      # sms is optional

# The service's own Postgres database (owner role), migrated at start.
# IDENTITY_DATABASE_URL=
# >= 32 random characters: HMAC key for codes, rate-limit keys and audit handles.
# IDENTITY_OTP_SECRET=
# The first admin (used only while no admin is connected).
# IDENTITY_BOOTSTRAP_ADMIN_EMAIL=

# Email codes, through your own mail server. Port 465 = TLS, 587 = STARTTLS (required).
# IDENTITY_SMTP_HOST=
# IDENTITY_SMTP_PORT=465
# IDENTITY_SMTP_USER=
# IDENTITY_SMTP_PASSWORD=
# IDENTITY_SMTP_FROM=ASafariM <no-reply@asafarim.site>

# Optional: where a sign-in that didn't come from an app goes (default https://asafarim.site/).
IDENTITY_HOME_URL=https://asafarim.site/
