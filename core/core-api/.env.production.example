# core-api in production (os-core-api and os-postgres in deploy/compose.prod.yml). Values never go in git as plaintext.
#
# 1. `node deploy/core-api/new-env.mjs` writes core/core-api/.env.production (git-ignored) with every value below
#    generated at random. It refuses to overwrite an existing file.
# 2. `pnpm env:encrypt:production` writes core/core-api/.env.production.age: commit only that (in a pull request).
# 3. The next full deploy decrypts it into .env.core-api and starts os-postgres and os-core-api. A commit without the
#    .age file deploys exactly as before, without them.
#
# The two passwords are used once, on os-postgres's FIRST start (an empty data volume). Changing them later in this
# file does not change them in the database.

# os-postgres's superuser: core-api's provisioner creates each installed app's role and database with it.
POSTGRES_PASSWORD=
# core-api's own login role (core_api), owner of the core database (deploy/core-api/initdb/10-core.sh).
CORE_API_DB_PASSWORD=

# The same two passwords, as URLs on os_core.
CORE_API_DATABASE_URL=
CORE_API_PROVISIONER_URL=

# >= 32 characters: the admin API's bearer token, for deploy/core-api/admin.sh on the VPS (loopback only).
CORE_API_ADMIN_TOKEN=

# An Ed25519 private JWK with a kid: signs the short-lived access tokens apps check.
CORE_API_TOKEN_SIGNING_JWK=
