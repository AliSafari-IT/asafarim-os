{
  "name": "@asafarim/site",
  "version": "0.1.0",
  "private": true,
  "description": "The asafarim.site landing page (asafarim-os#70): what ASafariM OS is, what has shipped, Admin and Notes screenshots and the roadmap, rendered to static HTML from one progress file.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
